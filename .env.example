# Supabase Configuration
# Obtain these from your Supabase project dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-actions

# Base Application URL (used for redirects and metadata)
NEXT_PUBLIC_APP_URL=https://cc-knowledge-base.vercel.app

# Demo Mode Flag (optional: true allows running demo mock auth & articles without active Supabase)
NEXT_PUBLIC_DEMO_MODE=true
